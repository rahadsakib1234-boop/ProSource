{
  "name": "prosource-crm",
  "version": "1.0.0",
  "description": "ProSource CRM - Sourcing Management Tool",
  "author": "Sakib Hossain",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.3.0",
    "@electron-forge/maker-deb": "^7.3.0",
    "@electron-forge/maker-dmg": "^7.3.0",
    "@electron-forge/maker-squirrel": "^7.3.0",
    "@electron-forge/maker-zip": "^7.3.0",
    "electron": "^28.0.0"
  },
  "config": {
    "forge": {
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "prosource_crm",
            "iconUrl": "https://raw.githubusercontent.com/YOUR_USERNAME/prosource-crm/main/icon.ico",
            "setupIcon": "./icon.ico"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": ["win32"]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {
            "icon": "./icon.png"
          }
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "icon": "./icon.icns"
          }
        }
      ]
    }
  }
}